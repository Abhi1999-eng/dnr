# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (required) ---
# MongoDB Atlas connection string. The app falls back to a local MongoDB when this
# is unset, which fails the build on a server that has no MongoDB installed.
MONGODB_URI=

# --- Auth (required) ---
# Signs the admin session cookie. Any long random value; generate with:
#   openssl rand -base64 48
JWT_SECRET=

# --- Inquiry email (required for the contact form to work) ---
# Without SMTP_USER, SMTP_PASS and MAIL_TO the inquiry route raises a named
# configuration error instead of silently dropping the enquiry.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# --- Image uploads (optional) ---
# All four are needed for S3. If any is blank, uploads are written to the
# instance disk at public/uploads instead, which is not backed up.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
